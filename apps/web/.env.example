# Production environment of the web project on Vercel. Off Vercel every variable has a working default.

# Neon, pooled connection.
DATABASE_URL=
# The map tiles on the public Blob store. Defaults to /tiles/inner-west.pmtiles on this site.
NEXT_PUBLIC_TILES_URL=
# The key that hashes each visitor's cookie (§6): 32 or more random characters, e.g. `openssl rand -hex 32`.
HASH_SECRET=
# The token Vercel Cron sends to /api/cron/hourly (§5.4): 32 or more random characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
# Not set by hand: Vercel's system environment variables must stay exposed (the default), because
# NEXT_PUBLIC_VERCEL_ENV is what turns BotID on in the browser.
